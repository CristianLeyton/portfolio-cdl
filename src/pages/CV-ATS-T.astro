---
import CVLayout from "../layouts/CVLayout.astro";
import { datosTecnico } from "../layouts/CVLayout.astro";
---

<CVLayout title="CV-ATS-T">
  <div id="cv-content" class="max-w-4xl mx-auto py-4 px-8">
    <section class="mb-6">
      <h1 class="font-bold mb-2 text-3xl text-center">{datosTecnico.nombre}</h1>
      <p class="text-center text-gray-600 mb-2">{datosTecnico.documento}</p>
      <p class="text-center text-indigo-600 font-semibold mb-4">
        {datosTecnico.titulo}
      </p>
      <div class="flex justify-between text-gray-600 font-semibold">
        <a
          href={`mailto:${datosTecnico.email}`}
          target="_blank"
          rel="noopener noreferrer">Email: {datosTecnico.email}</a
        >
        <p class="">Cel: {datosTecnico.telefono}</p>
      </div>

      <div class="flex justify-between text-gray-600 font-semibold">
        <p class="">
          CP: {datosTecnico.cp} · Dpto: {datosTecnico.departamento} · Prov: {
            datosTecnico.provincia
          }
        </p>
        {
          datosTecnico.link && (
            <a
              href={datosTecnico.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              Portfolio: {datosTecnico.link}
            </a>
          )
        }
      </div>

      <div class="flex justify-between text-gray-600 font-semibold mt-2">
        <p class="">Disponibilidad: {datosTecnico.disponibilidad}</p>
        <p class="">{datosTecnico.licencia}</p>
      </div>
    </section>

    <section class="mt-4">
      <h2 class="text-xl font-semibold">Resumen</h2>
      <p class="mt-2 text-gray-700">{datosTecnico.resumen}</p>
    </section>

    <section class="mt-4">
      <h2 class="text-xl font-semibold">Experiencia</h2>
      <ul class="list-disc pl-5 mt-2">
        {
          datosTecnico.experiencia.map((exp) => (
            <li class="mb-2">
              <span class="flex justify-between">
                <span>
                  <strong>{exp.title}</strong>, ({exp.empresa})
                </span>{" "}
                <span class="text-sm text-gray-500">| {exp.date}</span>{" "}
              </span>
              <p class="text-gray-700">{exp.description}</p>

              {exp.tasks && (
                <ul class="list-disc pl-5 mt-2">
                  {exp.tasks.map((task) => (
                    <li class="text-sm text-gray-700 mb-1">{task}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-4">
      <h2 class="text-xl font-semibold">Formación académica</h2>
      <ul class="list-disc pl-5 mt-2">
        {
          datosTecnico.formacion.map((edu) => (
            <li class="mb-2">
              <span class="flex justify-between">
                <strong>{edu.title}</strong>{" "}
                <span class="text-sm text-gray-500">| {edu.date}</span>{" "}
              </span>
              <p class="text-gray-700">{edu.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-4 pt-10">
      <h2 class="text-xl font-semibold">Aptitudes</h2>
      <ul class="list-disc pl-5 mt-2 grid grid-cols-2">
        {
          datosTecnico.aptitudes.map((apt) => (
            <li class="text-gray-700">{apt}</li>
          ))
        }
      </ul>
    </section>

    <section class="mt-4">
      <h2 class="text-xl font-semibold">Competencias profesionales</h2>
      <ul class="list-disc pl-5 mt-2">
        {
          datosTecnico.competenciasProfesionales.map((comp) => (
            <li class="text-gray-700 mb-1">{comp}</li>
          ))
        }
      </ul>
    </section>

    {
      datosTecnico.presentacion && (
        <section class="mt-4">
          <h2 class="text-xl font-semibold">Más sobre mí</h2>
          <p class="mt-2 text-gray-700">{datosTecnico.presentacion}</p>
        </section>
      )
    }
  </div>
</CVLayout>

<style>
  body {
    font-family: none;
  }
</style>
